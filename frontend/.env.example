# Frontend env — copy to .env.local.
# No secrets belong here: NEXT_PUBLIC_* is shipped to the browser.
# Provider API keys stay in backend/.env only.

NEXT_PUBLIC_CARDANO_NETWORK=preprod

# Leave empty (default): the browser calls this site same-origin at
# /backend/* and the Next server proxies to BACKEND_INTERNAL_URL — works
# under any hostname or IP, no CORS. Set it only to make browsers call a
# backend at a DIFFERENT address (inlined into the bundle at build time).
NEXT_PUBLIC_API_URL=

# Server-side proxy target (runtime, not baked). Default: http://localhost:3001
#BACKEND_INTERNAL_URL=http://localhost:3001

# Root env — consumed by docker-compose.yml (self-hosted deployment) and
# infra/docker-compose.yml (dev: postgres only).
# Copy to .env and adjust. Never commit the real .env.

# REQUIRED for trading: a free Blockfrost PREPROD project id (starts with
# "preprod") — create one at https://blockfrost.io. This is the only value
# you must fill in.
BLOCKFROST_PROJECT_ID_PREPROD=

# PostgreSQL (order cache only — the chain is the source of truth).
POSTGRES_USER=p2pdex
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=p2pdex
POSTGRES_PORT=5432

# Ports published on your machine (docker compose deployment).
#FRONTEND_PORT=3000
#BACKEND_PORT=3001

# Advanced, normally NOT needed: the site works under any hostname/IP via
# its built-in same-origin API proxy. Set these only to make browsers call
# a backend at a DIFFERENT address than the site (NEXT_PUBLIC_API_URL is
# baked into the frontend at build time; CORS_ORIGIN must then match the
# site's origin).
#NEXT_PUBLIC_API_URL=
#CORS_ORIGIN=http://localhost:3000

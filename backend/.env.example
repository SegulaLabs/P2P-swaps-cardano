# Backend env — copy to .env. NEVER commit the real .env.
# This backend is non-custodial: it holds NO keys and refuses to boot if any
# key-material env var (PRIVATE_KEY/MNEMONIC/SEED_PHRASE/...) is present.

# Hard guard: the server refuses to boot on any other value (preprod-only MVP).
CARDANO_NETWORK=preprod

PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (matches infra/docker-compose.yml + root .env)
DATABASE_URL=postgres://p2pdex:change-me-locally@localhost:5432/p2pdex

# Blockfrost PREPROD project id (starts with "preprod").
# Leave empty to boot without a provider: read endpoints work from the DB
# cache; tx building / indexing return 503 until configured.
BLOCKFROST_PROJECT_ID_PREPROD=

# Protocol wiring. Hashes are derived from the compiled blueprint
# (src/protocol/plutus.json); set these to CROSS-CHECK — boot fails on
# mismatch. Values for the current build:
#   ORDER_VALIDATOR_HASH=1757ecd8fdc1c3d095906f13f17acdf8262a7c2363ac69ddeb256f8b
#   BEACON_POLICY_ID=c14dc44ed1e2025bae03895af442f2fa9d387deb526b6518b5aa8702
PROTOCOL_VERSION=3
ORDER_VALIDATOR_HASH=
BEACON_POLICY_ID=

# Optional CIP-33 reference scripts (docs/deployment.md §3). When unset,
# transactions attach the full scripts instead (bigger txs, same behavior).
REFERENCE_SCRIPT_TX_ID=
REFERENCE_SCRIPT_INDEX=0

# Deposit locked with each order (lovelace). Over-provisioned vs the ledger
# min-UTxO; the excess returns to the seller on take / owner on cancel.
ORDER_DEPOSIT_LOVELACE=3500000

# Max orders one TakeManyOrders tx may consume (v2 atomic batches;
# tx-size/ex-unit budget — docs/take-many-orders.md §6).
MAX_ORDERS_PER_TX=8

# Indexer tuning. The frontend's "Refresh" button (POST /indexer/reindex) is
# the primary way the order cache stays fresh; INDEXER_POLL_MS is just a slow
# background safety net so a page nobody clicks on doesn't go stale forever
# and spent orders eventually get reclassified. Keep both far apart to
# minimize provider (Blockfrost) request volume on a 24/7 site.
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_MS=900000
INDEXER_MIN_REINDEX_INTERVAL_MS=20000

    "p2p_dex/types/BeaconRedeemer": {
      "title": "BeaconRedeemer",
      "description": "Minting redeemers for the beacon policy.",
      "anyOf": [
        {
          "title": "MintBeacons",
          "description": "Mint the exact 5-beacon set into valid order outputs only.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "BurnBeacons",
          "description": "Burn-only (all amounts negative). Safe unconditionally: spending the\n UTxO that holds beacons always runs the order validator.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        }
      ]
    },
    "p2p_dex/types/OrderDatum": {
      "title": "OrderDatum",
      "description": "Inline datum attached to every order UTxO.",
      "anyOf": [
        {
          "title": "OrderDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "version",
              "description": "Protocol version; 1 for MVP.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "beacon_policy_id",
              "description": "The beacon policy id; checked by the minting policy at creation to equal\n its own hash, so spending code may trust it afterwards.",
              "$ref": "#/definitions/cardano~1assets~1PolicyId"
            },
            {
              "title": "owner",
              "description": "Owner's STAKING credential. MVP: must be a VerificationKey credential\n (script owners rejected at mint time — open-questions #8).",
              "$ref": "#/definitions/cardano~1address~1Credential"
            },
            {
              "title": "payment_address",
              "description": "Where the ask payment must go on TakeOrder.",
              "$ref": "#/definitions/cardano~1address~1Address"
            },
            {
              "title": "offer",
              "description": "Asset being sold.",
              "$ref": "#/definitions/p2p_dex~1types~1AssetClass"
            },
            {
              "title": "offer_amount",
              "description": "Amount of `offer` locked in the order. Strictly positive.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "ask",
              "description": "Asset the owner wants in return.",
              "$ref": "#/definitions/p2p_dex~1types~1AssetClass"
            },
            {
              "title": "ask_amount",
              "description": "Amount of `ask` that must reach `payment_address`. Strictly positive.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "expiration",
              "description": "Optional expiry as POSIX time in ms (NOT a slot — docs/eutxo.md §6).",
              "$ref": "#/definitions/Option<Int>"
            },
            {
              "title": "allow_partial_fill",
              "description": "MUST be False in MVP; reserved for a future partial-fill upgrade.",
              "$ref": "#/definitions/Bool"
            }
          ]
        }
      ]
    },
    "p2p_dex/types/OrderRedeemer": {
      "title": "OrderRedeemer",
      "description": "Spending redeemers for the order validator.\n UpdateOrder is deliberately absent — postponed post-MVP so that EVERY\n spend destroys all beacons (docs/mvp-contract-decisions.md §7).",
      "anyOf": [
        {
          "title": "CancelOrder",
          "description": "Owner reclaims the order; all beacons destroyed.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "TakeOrder",
          "description": "Full fill only: exact tagged payment (ask + deposit) to\n `payment_address`, all beacons destroyed. v2: many orders may be taken\n in one tx — each needs its own PaymentTag-tagged payment output.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        }
      ]
    }
